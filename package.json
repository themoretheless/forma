{
  "name": "forma-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test",
    "bench": "node scripts/perf-bench.mjs",
    "bench:window": "node scripts/window-bench.mjs",
    "example:controls": "node scripts/controls-example.mjs",
    "generate:form": "node scripts/generate-form.mjs",
    "example:bindings": "cargo run --locked --manifest-path vector-ui/examples/binding-app/Cargo.toml",
    "example:bindings:native": "cargo run --locked --manifest-path vector-ui/examples/binding-app/Cargo.toml --features native",
    "build:wasm": "node scripts/build-wasm.mjs",
    "version:check": "node scripts/versions.mjs check",
    "version:set": "node scripts/versions.mjs set",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "codemirror": "^6.0.2",
    "zod": "^4.5.4",
    "@codemirror/commands": "^6.11.0"
  }
}
