component CustomerForm {
    contextType: 'crate::CustomerVm';
    events: ['saveRequested'];

    Frame {
        width: 360;
        height: 290;
        padding: 20;
        gap: 12;
        background: #181e2a;

        TextField {
            key: 'nameInput';
            value <-> state.name;
        }
        TextField {
            key: 'cityInput';
            contextType: 'crate::AddressVm';
            context: state.address;
            value <-> state.city;
        }
        Button {
            key: 'saveButton';
            text: 'Сохранить';
            disabled: state.busy;
            clicked -> events.saveRequested();
        }
        Button {
            key: 'statusLabel';
            text: state.status;
            disabled: true;
        }
    }
}
