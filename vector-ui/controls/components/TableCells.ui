component TableCells {
    first: ''; second: ''; third: '';
    color: state.theme.text; muted: state.theme.textMuted; fontSize: 13;
    Frame {
        columns: [1.4*, 0.8*, 0.7*]; gap: 10; padding: 0 12;
        Frame { cell: 1 1; columns: [auto, *]; Label { cell: 1 1; text: props.first; color: props.color; fontSize: props.fontSize; } }
        Frame { cell: 1 2; columns: [auto, *]; Label { cell: 1 1; text: props.second; color: props.muted; fontSize: props.fontSize; } }
        Frame { cell: 1 3; columns: [*, auto]; Label { cell: 1 2; text: props.third; color: props.muted; fontSize: props.fontSize; } }
    }
}
