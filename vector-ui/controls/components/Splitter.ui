// Separate hit target; parent composition chooses sizes after a drag.
component Splitter : Button {
    width: 8; height: 160; radius: 0; borderWidth: 0;
    background: state.theme.canvas;
    hoverBackground: state.theme.borderStrong;
    pressedBackground: state.theme.primary;
    text: 'Изменить ширину панели';
    override content: Frame {};
}
