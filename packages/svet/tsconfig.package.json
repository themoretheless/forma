{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src/engine",
    "outDir": "./dist/package",
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/engine/**/*.ts"]
}
