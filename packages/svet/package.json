{
  "name": "svet-engine",
  "version": "0.3.5",
  "description": "Svet: reactive TypeScript + Rust WebAssembly UI framework",
  "type": "module",
  "main": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/package/jsx-runtime.d.ts",
      "import": "./dist/package/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/package/jsx-runtime.d.ts",
      "import": "./dist/package/jsx-runtime.js"
    },
    "./slim": {
      "types": "./dist/package/slim.d.ts",
      "import": "./dist/package/slim.js"
    },
    "./slim/jsx-runtime": {
      "types": "./dist/package/slim-jsx-runtime.d.ts",
      "import": "./dist/package/slim-jsx-runtime.js"
    },
    "./slim/jsx-dev-runtime": {
      "types": "./dist/package/slim-jsx-runtime.d.ts",
      "import": "./dist/package/slim-jsx-runtime.js"
    },
    "./slim/reactivity": {
      "types": "./dist/package/reactivity.d.ts",
      "import": "./dist/package/reactivity.js"
    },
    "./forma-3d": {
      "types": "./dist/package/forma-3d.d.ts",
      "import": "./dist/package/forma-3d.js"
    },
    "./server": {
      "types": "./dist/package/server.d.ts",
      "import": "./dist/package/server.js"
    },
    "./compiler": {
      "types": "./dist/package/compiler.d.ts",
      "import": "./dist/package/compiler.js"
    },
    "./reactivity": {
      "types": "./dist/package/reactivity-entry.d.ts",
      "import": "./dist/package/reactivity-entry.js"
    },
    "./server-runtime": {
      "types": "./dist/package/ssr-runtime-entry.d.ts",
      "import": "./dist/package/ssr-runtime-entry.js"
    },
    "./core.wasm": {
      "types": "./dist/package/svet-core.wasm.d.ts",
      "default": "./dist/package/svet-core.wasm"
    }
  },
  "scripts": {
    "build:wasm": "cd crates/svet-wasm && RUSTFLAGS=\"-C target-feature=+simd128\" cargo build --target wasm32-unknown-unknown --release && node ../../scripts/embed-wasm.mjs",
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run build:wasm && tsc --noEmit && npm run build:package && vite build",
    "build:package": "node scripts/build-package.mjs",
    "pretest": "npm run build:package",
    "prepack": "npm run build:package",
    "test:package": "npm run build:package && node scripts/check-package.mjs",
    "test:actions": "npm run build:package && node --test scripts/check-action-http.mjs",
    "dev:actions": "node scripts/serve-action-browser.mjs",
    "dev:resume": "npm run build:package && node scripts/serve-resumption-browser.mjs",
    "bench:scaling": "npm run build:package && node scripts/bench-graph-scaling.mjs",
    "bench:adoption:prepare": "node scripts/prepare-adoption-bench.mjs",
    "bench:resident-app:prepare": "node scripts/prepare-resident-app-bench.mjs",
    "test:edge": "npm run build:package && node scripts/check-edge-ssr.mjs",
    "typecheck:indexed": "node scripts/check-indexed-access.mjs",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@babel/parser": "^8.0.10",
    "@eslint/js": "^9.39.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "magic-string": "^1.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "./dist/package/server.js",
    "./dist/package/index.js",
    "./dist/package/jsx-runtime.js",
    "./dist/package/reactivity-entry.js",
    "./dist/package/ssr-runtime-entry.js",
    "./dist/package/wasm-embedded.js",
    "./dist/package/forma-3d.js"
  ],
  "files": [
    "dist/package",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "peerDependencies": {
    "@babel/parser": "^8.0.10",
    "magic-string": "^1.4.5"
  },
  "peerDependenciesMeta": {
    "@babel/parser": {
      "optional": true
    },
    "magic-string": {
      "optional": true
    }
  }
}
