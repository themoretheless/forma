root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,toml,py,wgsl,cu,ui}]
indent_size = 4

[*.rs]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[{crates/*/benchmarks/**,crates/*/qualification/**,packages/svet/benchmarks/**,packages/svet/src/engine/wasm-binary.ts}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
