// Passive inline message. Dialog focus, live announcements and actions are separate.
component Alert : Surface {
    width: 360;
    height: 76;
    radius: 12;
    text: 'Токены обновлены';
    description: 'Светлая и тёмная тема готовы.';
    descriptionColor: state.theme.textMuted;
    descriptionFontSize: 12;
    iconSize: 20;
    tone: 'accent';
    match props.tone {
        'success' => {
            background: state.theme.successWash;
            borderColor: state.theme.success;
            icon: 'assets/check-circle.svg';
        }
        'warning' => {
            background: state.theme.warningWash;
            borderColor: state.theme.warning;
            icon: 'assets/warning.svg';
        }
        'danger' => {
            background: state.theme.dangerWash;
            borderColor: state.theme.dangerInk;
            icon: 'assets/error.svg';
        }
        _ => {
            background: state.theme.accentWash;
            borderColor: state.theme.accentInk;
            icon: 'assets/info.svg';
        }
    }

    override content: MessageContent {
        forward props { icon, iconSize, text, fontSize, description, descriptionColor, descriptionFontSize };
        iconColor: props.borderColor;
        color: props.textColor;
    };
}
