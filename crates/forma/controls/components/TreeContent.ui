// Passive tree-row composition; indent is an explicit logical-pixel offset.
component TreeContent {
    text: 'Элемент';
    badge: '';
    color: state.theme.text;
    iconColor: props.color;
    fontSize: 13;
    branch: false;
    expanded: false;
    showChevron: true;
    indent: 0;
    icon: 'assets/file.svg';

    Frame {
        columns: [props.indent, 10, 20, *];
        padding: 0 2;
        gap: 3;
        ContentPresenter {
            key: 'disclosure';
            content: match (props.branch, props.showChevron) {
                (true, true) => Icon {
                    cell: 1 2;
                    width: 12;
                    height: 12;
                    color: props.color;
                    source: match props.expanded {
                        true => 'assets/chevron-down.svg';
                        _ => 'assets/chevron-right.svg';
                    };
                };
                _ => Frame { cell: 1 2; };
            };
        }
        Frame {
            cell: 1 3;
            width: 20;
            height: 16;
            Icon {
                source: props.icon;
                color: props.iconColor;
                width: 20;
                height: 16;
            }
            Frame {
                rows: [1, *];
                Label {
                    cell: 2 1;
                    text: props.badge;
                    color: props.color;
                    fontSize: 6.5;
                }
            }
        }
        StartLabel {
            cell: 1 4;
            text: props.text;
            color: props.color;
            fontSize: props.fontSize;
        }
    }
}
