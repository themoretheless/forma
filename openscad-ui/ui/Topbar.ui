component Topbar {
    Grid {
        width: 1180;
        height: 48;
        columns: [148, 282, 164, *, 120, 116];
        rows: [32];
        padding: 8 14;
        gap: 10;
        background: state.theme.surface;

        LeadingIconButton {
            cell: 1 1;
            key: 'brandFileBtn';
            width: *;
            height: 32;
            icon: 'assets/file.svg';
            text: 'OpenSCAD · Файл';
            clicked -> actions.openFileMenu();
        }

        Row {
            cell: 1 2;
            width: *;
            height: 32;
            padding: 1;
            gap: 2;
            radius: 8;
            background: state.theme.canvas;

            SegmentButton {
                key: 'modeSolid';
                width: *;
                height: 30;
                text: 'Solid';
                selected: true;
                clicked -> actions.openWorkspaceMode('solid');
            }

            SegmentButton {
                key: 'modeMesh';
                width: *;
                height: 30;
                text: 'Mesh';
                selected: false;
                clicked -> actions.openWorkspaceMode('mesh');
            }

            SegmentButton {
                key: 'modeCode';
                width: *;
                height: 30;
                text: 'Code';
                selected: false;
                clicked -> actions.openWorkspaceMode('code');
            }
        }

        Badge {
            cell: 1 3;
            key: 'kernelBadge';
            width: *;
            height: 28;
            tone: 'accent';
            text: 'Manifold · Forma GPU';
        }

        SearchField {
            cell: 1 4;
            key: 'commandSearch';
            width: *;
            height: 32;
            value: '';
            placeholder: 'Команды и примитивы…';
            suffix: '⌘K';
        }

        SecondaryButton {
            cell: 1 5;
            key: 'toggleCodeBtn';
            width: *;
            height: 32;
            text: 'Исходный код';
            clicked -> actions.toggleEditor();
        }

        PrimaryButton {
            cell: 1 6;
            key: 'exportBtn';
            width: *;
            height: 32;
            text: 'Экспорт 3MF';
            clicked -> actions.openExportDialog();
        }
    }
}
