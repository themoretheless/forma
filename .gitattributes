# Golden files are compared byte for byte; keep them LF on every platform, Windows included.
crates/forma/tests/golden/** text eol=lf
crates/gpu-shader/tests/golden/** text eol=lf
# Upstream license text is stored byte for byte so it matches PROVENANCE.json.
crates/forma/assets/mono/*.OFL.txt -text
crates/forma/assets/bold/*.UFL.txt -text
# Shader sources and generated shader/layout mirrors are compared verbatim across platforms.
*.wgsl text eol=lf
src/services/shaders/generated/** text eol=lf
crates/raster-core/src/generated_layouts.rs text eol=lf
